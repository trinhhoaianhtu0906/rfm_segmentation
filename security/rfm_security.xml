<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_rfm" model="ir.module.category">
        <field name="name">RFM Segmentation</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_rfm" model="res.groups.privilege">
        <field name="name">RFM Segmentation</field>
        <field name="category_id" ref="module_category_rfm"/>
    </record>

    <record id="group_rfm_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_rfm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rfm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_rfm"/>
        <field name="implied_ids" eval="[(4, ref('group_rfm_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rfm_segment_view_list" model="ir.ui.view">
        <field name="name">rfm.segment.list</field>
        <field name="model">rfm.segment</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="rfm_segment_view_form" model="ir.ui.view">
        <field name="name">rfm.segment.form</field>
        <field name="model">rfm.segment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                    <field name="description" placeholder="When to use this segment"/>
                    <field name="partner_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="rfm_score"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rfm_segment_action" model="ir.actions.act_window">
        <field name="name">RFM Segments</field>
        <field name="res_model">rfm.segment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
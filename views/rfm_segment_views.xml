<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rfm_segment_view_list" model="ir.ui.view">
        <field name="name">rfm.segment.list</field>
        <field name="model">rfm.segment</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_compute_rfm" type="object" string="Compute RFM now"
                            display="always" groups="rfm_segmentation.group_rfm_manager"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="r_min" string="R from"/>
                <field name="r_max" string="R to"/>
                <field name="f_min" string="F from"/>
                <field name="f_max" string="F to"/>
                <field name="partner_count"/>
            </list>
        </field>
    </record>

    <record id="rfm_segment_view_form" model="ir.ui.view">
        <field name="name">rfm.segment.form</field>
        <field name="model">rfm.segment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partners" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Customers"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group string="Score ranges">
                            <label for="r_min" string="Recency"/>
                            <div class="o_row">
                                <field name="r_min"/> - <field name="r_max"/>
                            </div>
                            <label for="f_min" string="Frequency"/>
                            <div class="o_row">
                                <field name="f_min"/> - <field name="f_max"/>
                            </div>
                        </group>
                    </group>
                    <field name="description" placeholder="When to use this segment"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rfm_segment_action" model="ir.actions.act_window">
        <field name="name">RFM Segments</field>
        <field name="res_model">rfm.segment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
